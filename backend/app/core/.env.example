# ==============================================================================
# FASTAPI BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env (or copy to app/core/.env)
# ==============================================================================

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ecommerce_db"

# JWT Authentication Security
SECRET_KEY="your-secure-random-secret-key-here-generate-with-openssl"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=900

# Safepay Payment Gateway (Sandbox / Production)
SAFEPAY_API_KEY="your_safepay_api_secret_key"
SAFEPAY_MERCHANT_KEY="sec_your_safepay_merchant_key"
SAFEPAY_WEBHOOK_SECRET="your_safepay_webhook_signature_secret"
